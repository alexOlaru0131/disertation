@startuml

box "ESP32" #White
  participant "Main Task"
end box

box "Raspberry Pi" #LightBlue
  participant "Reasoning Process"
  participant "Kinematics Process"
  participant "Server Process"
  participant "USB Process"
end box

box "Feather M0" #LightGreen
  participant "Scheduler"
  participant "USB Task"
  participant "IMU Task"
  participant "PWM Controllers Task"
  participant "LED Task"
  participant "Display Task"
end box

participant "PCA9685 1"
participant "PCA9685 2"
participant ICM20948
participant "LED (A0)"
participant ILI9488


"Scheduler" -> "USB Task": spawn()
"Scheduler" -> "IMU Task": spawn()
"IMU Task" -> ICM20948: new()
"Scheduler" -> "PWM Controllers Task": spawn()
"Scheduler" -> "LED Task": spawn()
"PWM Controllers Task" -> "PCA9685 1": new()
"PWM Controllers Task" -> "PCA9685 2": new()
"Scheduler" -> ILI9488: new()
"Scheduler" -> "Display Task": spawn()

"USB Task" -> "USB Task": wait(1000 ms)
"IMU Task" -> ICM20948: init()
"Display Task" -> ILI9488: init()

note over "USB Task"
  ar merge un mesaj de confirmare ca a pornit firmware-ul sau un break
end note

"Server Process" -> "USB Process": spawn()
"Server Process" -> "Kinematics Process": spawn()
"Server Process" -> "Reasoning Process": spawn()

"Kinematics Process" -> "Kinematics Process": load control params
"Reasoning Process" -> "Reasoning Process": load reasoning params

loop 

  "USB Task" -> "USB Task": poll_usb()
  "IMU Task" -> "Scheduler": lock usb

    alt Ok(())

      "IMU Task" -> "IMU Task": wait(15 ms)

    else Err(error)

      "IMU Task" -> "USB Process": icm20948_init_error
      note right
          ce facem cu eroarea?
        end note

    end

  alt Mission: move to target

    "Reasoning Process" -> "Reasoning Process": set mission: move
    "Reasoning Process" -> "Kinematics Process": send target point

    loop until reached position

      alt request imu

        "Kinematics Process" -> "USB Process": request imu

        "USB Process" -> "USB Task": 0x10

        note right
          trebuie pus raspuns ca a fost primita comanda
        end note

        "USB Task" -> "Scheduler": request imu
        "USB Task" -> "USB Task": delay(5 ms)
        "IMU Task" -> "Scheduler": lock i2c
        "IMU Task" -> ICM20948: read_measurements()
        "IMU Task" -> "Scheduler": lock usb

        alt Ok(())

          "IMU Task" -> "USB Process": imu values
          "Kinematics Process" <- "USB Process": imu values
          "Kinematics Process" -> "Kinematics Process": compute current x y z position
          "Kinematics Process" -> "Kinematics Process": compute next x y z position
          "Kinematics Process" -> "Kinematics Process": prepare move motors

        else Err(error)

          "IMU Task" -> "USB Process": icm20948_error_packet
          "Kinematics Process" <- "USB Process": error

        end

        "IMU Task" -> "IMU Task": delay(1 ms)

      else move legs

        "Kinematics Process" -> "Kinematics Process": compute inverse kinematics
        "Kinematics Process" -> "USB Process": send pwm values
        "USB Process" -> "USB Task": 0x20, pwm values
        "USB Task" --> "USB Process": 0xE1
        note right
          aici va fi schimbat, trebuie sa fie un raspuns exact
        end note
        "USB Task" -> "USB Task": delay(5 ms)
        "PWM Controllers Task" -> "Scheduler": lock pwm values
        "PWM Controllers Task" -> "PCA9685 1": update_pwm()
        "PWM Controllers Task" -> "PCA9685 2": update_pwm()
        "PWM Controllers Task" -> "Scheduler": lock usb

        alt Ok(())

          "PWM Controllers Task" -> "USB Process": [0x20; 20][..]

        note right
          pentru ca asta nu prea face sens si e prea lung
        end note

        "Kinematics Process" <- "USB Process": ok
        "Kinematics Process" -> "Kinematics Process": prepare imu request

        else Err(error)

          "PWM Controllers Task" -> "USB Process": pca9685_error_packet
          "Kinematics Process" <- "USB Process": error

        end

      "PWM Controllers Task" -> "PWM Controllers Task": delay(5 ms)

    else use camera

      "Reasoning Process" -> "Kinematics Process": send camera position
      "Kinematics Process" -> "Kinematics Process": compute inverse kinematics for camera
      "Kinematics Process" -> "USB Process": send pwm values

      "USB Process" -> "USB Task": 0x20, pwm values
      "USB Task" --> "USB Process": 0xE1
      note right
        aici va fi schimbat, trebuie sa fie un raspuns exact
      end note
      "USB Task" -> "USB Task": delay(5 ms)
      "PWM Controllers Task" -> "Scheduler": lock pwm values
      "PWM Controllers Task" -> "PCA9685 1": update_pwm()
      "PWM Controllers Task" -> "PCA9685 2": update_pwm()
      "PWM Controllers Task" -> "Scheduler": lock usb

      alt Ok(())

        "PWM Controllers Task" -> "USB Process": [0x20; 20][..]

      note right
        pentru ca asta nu prea face sens si e prea lung
      end note

      "Kinematics Process" <- "USB Process": ok

      else Err(error)

        "PWM Controllers Task" -> "USB Process": pca9685_error_packet
        "Kinematics Process" <- "USB Process": error

      end


      "USB Process" -> "USB Task": 0x30

      note right
        trebuie pus raspuns ca a fost primita comanda
      end note

      "USB Task" -> "Scheduler": request led
      "USB Task" -> "USB Task": delay(5 ms)
      "LED Task" -> "LED (A0)": on/off
      "LED Task" -> "LED Task": delay(5 ms)

      end

    end

  end

end

@enduml
